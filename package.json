{
  "name": "raja-rani-game",
  "version": "1.0.0",
  "type": "module",
  "description": "Raja Rani - Indian Royal Multiplayer Deduction Game (5-30 players)",
  "main": "server/index.ts",
  "scripts": {
    "dev": "node --watch-path=server --import tsx server/index.ts",
    "dev:next": "next dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "start:server": "node dist-server/index.js",
    "lint": "next lint",
    "preview": "npm start",
    "prestart": "npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.395.0",
    "mongoose": "^8.4.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5"
  }
}
