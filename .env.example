# Server Port (default 5000)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# MongoDB Connection String (Optional: guest gameplay works seamlessly if MongoDB is unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/raja_rani

# Cryptographic Secret for Player Session Tokens
JWT_SECRET=raja_rani_royal_secret_token_key_change_in_production

# Public Website Origin URL
CLIENT_URL=http://localhost:5000
